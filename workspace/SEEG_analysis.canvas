      "file": "color_analyse_0727/result/rereference_hfb110_140_s2_s3_peak_latency_mni_y_acc055_20260824/HFB-S3/reference_shaft_car/mni_y_vs_peak_latency_acc_ge_055_exponential_size.png",
      "x": 3540,
      "y": 7600,
      "width": 720,
      "height": 450
